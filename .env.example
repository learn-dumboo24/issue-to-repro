# Copy to .env for local runs. Never commit .env.

# Option A - Gemini API key (AI Studio). Used in Claude Code cloud sessions, where the
# session proxy injects the real key, so GOOGLE_API_KEY only needs a placeholder there.
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_API_KEY=placeholder

# Claude instead of Gemini for the agents (needs a key; keep it in this file, never in git):
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# COORDINATOR_MODEL=claude-haiku-5-5
# WORKER_MODEL=claude-haiku-5-5
# BACKTEST_MAX_USD=1.50

# Retriever search: "keyword" (default) or "semantic" (hybrid BM25 + Gemini embeddings).
# RETRIEVAL=semantic

# Where reproduction tests run: "local" (development, trusted repos) or "docker" (isolated).
# SANDBOX=docker

# Option B - Vertex AI (Cloud Run / your machine with `gcloud auth application-default login`).
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
